# Auth V2 SMS configuration
# Development only: returns the OTP in the API response when explicitly enabled.
AUTH_RETURN_DEV_OTP=false
AUTH_OTP_TTL_MS=300000
AUTH_OTP_RESEND_COOLDOWN_MS=45000
AUTH_OTP_MAX_ATTEMPTS=5

# Production must use a real provider. Never put these values in the mobile app.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=