# Production Environment Variables
# Замени значения на реальные для своего сервера

PORT=4000

# MongoDB Atlas Connection String
# Формат: mongodb+srv://username:password@cluster-name.xxxxx.mongodb.net/database-name?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mywork?retryWrites=true&w=majority

# JWT Secret - ОБЯЗАТЕЛЬНО замени на длинную случайную строку (минимум 32 символа)
# Генерируется: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_me_minimum_32_chars_random_string_here

# JWT Tokens Expiration
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Опционально: Логирование
LOG_LEVEL=info

# Опционально: Рейт лимитирование
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
